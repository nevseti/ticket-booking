# Шаблон ~/ticket-booking/.env на сервере. Секреты сгенерируй:
#   openssl rand -hex 32
# API_IMAGE, WEB_IMAGE и IMAGE_TAG перезаписываются при каждом деплое из GitHub Actions.

DOMAIN=nevseti.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

API_IMAGE=ghcr.io/nevseti/ticket-booking-api
WEB_IMAGE=ghcr.io/nevseti/ticket-booking-web
IMAGE_TAG=latest

POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tickets

RABBITMQ_USER=tickets
RABBITMQ_PASSWORD=change-me

SECRET_KEY=change-me
WEB_CONCURRENCY=1
