# Локальная разработка: значения по умолчанию уже указывают на docker-compose.yml,
# этот файл нужен только чтобы что-то переопределить. Скопируй в backend/.env.
# DATABASE_URL=postgresql+asyncpg://tickets:tickets@localhost:5433/tickets
# REDIS_URL=redis://localhost:6379/0
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# SECRET_KEY=...  (на проде обязателен, не короче 32 символов)
# LOG_LEVEL=DEBUG
